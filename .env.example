# Copy this file to .env.local and fill it in. Never commit .env.local.

# Qloo: your key, and the origin it was issued for.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Postgres. The tables are made on first use, so the login needs to be able to create them.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/afinlo

# Optional: OpenAI writes the pitch and the emails, reads typed changes, and runs the tour team. Without it, drafts are
# templates and the tour team says it needs a key.
OPENAI_API_KEY=

# Optional
# DAILY_PLANS=300       # new plans, brand matches and pairings the whole server makes in 24 hours
# HOURLY_PLANS=8        # the same, for one visitor in an hour
# DAILY_CHAT=600        # messages to tour teams the whole server answers in 24 hours
# HOURLY_CHAT=30        # the same, for one visitor in an hour
# TRUST_PROXY=1         # behind a host or proxy that sets X-Forwarded-For (Vercel does): limits use the visitor's address
# PUBLIC_URL=           # the public address, when a proxy in front shows the server another origin
# PDF_BROWSER=          # the Chrome or Edge that prints decks as PDF (default: the usual install places)
